{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_github}/issues",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.volwert123.more_food.fabric.MFFabric"
    ],
    "fabric-datagen": [
      "net.volwert123.more_food.datagen.MFDataGenerators"
    ]
  },
  "accessWidener": "${mod_id}.classtweaker",
  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "balm": ">=${balm_version}"
  },
  "custom": {
    "modmenu": {
      "update_checker": true,
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/more-food-xd",
        "modmenu.modrinth": "https://modrinth.com/mod/more-food-xd"
      }
    }
  }
}